{
  "version": 1,
  "servers": {
    "wikipedia": {
      "transport": "sse",
      "protocol_version": "2024-11-05",
      "minimal_init": true,
      "command": "/home/vscode/.local/bin/wikipedia-mcp",
      "args": [
        "--transport",
        "sse",
        "--host",
        "mcp-wiki",
        "--port",
        "8765",
        "--log-level",
        "ERROR"
      ],
      "env": {
        "FASTMCP_SHOW_CLI_BANNER": "false",
        "FASTMCP_LOG_ENABLED": "false"
      }
    },
    "stackoverflow": {
      "transport": "sse",
      "protocol_version": "2024-11-05",
      "minimal_init": true,
      "command": "python",
      "args": ["-m", "stackoverflow_mcp", "--host", "mcp-stackoverflow", "--port", "8766"]
    },
    "textbooks": {
      "transport": "stdio",
      "command": "python",
      "args": ["-m", "mcp_textbooks_server"],
      "enabled": false
    }
  }
}
