{
  "version": 1,
  "servers": {
    "wikipedia": {
      "transport": "sse",
      "command": "/home/vscode/.local/bin/wikipedia-mcp",
      "args": [
        "--transport",
        "sse",
        "--host",
        "127.0.0.1",
        "--port",
        "8765",
        "--log-level",
        "ERROR"
      ],
      "env": {
        "FASTMCP_SHOW_CLI_BANNER": "false",
        "FASTMCP_LOG_ENABLED": "false"
      }
    },
    "stackoverflow": {
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-remote", "mcp.stackoverflow.com"],
      "env": {
        "STACKOVERFLOW_API_KEY": ""
      }
    },
    "textbooks": {
      "transport": "stdio",
      "command": "python",
      "args": ["-m", "mcp_textbooks_server"],
      "enabled": false,
      "env": {
        "TEXTBOOKS_DATA_PATH": "",
        "TEXTBOOKS_INDEX_PATH": ""
      }
    }
  }
}
